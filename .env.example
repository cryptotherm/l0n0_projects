# CT TestBench Server Environment Variables
# Copy this to .env and fill in your values

# Database (auto-configured in Docker Compose)
DATABASE_URL=postgresql+asyncpg://testbench:testbench@localhost:5432/testbench

# OpenAI (required for AI diagnosis)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Brother QL-810W Printer
PRINTER_MODEL=QL-810W
PRINTER_IDENTIFIER=tcp://192.168.1.200
LABEL_TYPE=62

# Miner default credentials
MINER_USERNAME=root
MINER_PASSWORD=root

# InfluxDB (optional time-series)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=ct-testbench-influx-token
INFLUX_ORG=cryptotherm
INFLUX_BUCKET=miners

# RGB LED (Raspberry Pi only)
RGB_ENABLED=false
RGB_LED_COUNT=60
RGB_LED_PIN=18
LUXOR_API_KEY=your-luxor-api-key-here
