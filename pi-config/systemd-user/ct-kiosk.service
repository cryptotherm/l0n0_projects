[Unit]
Description=CT TestBench Kiosk (Chromium)
After=graphical-session.target labwc.service
Wants=graphical-session.target

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=/bin/sh -c 'until [ -S ${XDG_RUNTIME_DIR}/wayland-0 ]; do sleep 1; done'
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8000/health; do sleep 1; done'
ExecStart=/usr/bin/chromium     --ozone-platform=wayland     --kiosk     --noerrdialogs     --disable-infobars     --disable-translate     --no-first-run     --disable-pinch     --overscroll-history-navigation=0     --check-for-update-interval=31536000     --force-device-scale-factor=1.5     --disable-restore-session-state     --remote-debugging-port=9223     --remote-allow-origins=*     --app=http://localhost:8000/
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
